{
    "swagger": "2.0",
    "info": {
        "description": "Tannery app API for lightweight web messenger made for few friends",
        "title": "Tannery App",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/auth/sign-in": {
            "post": {
                "description": "authenticate auth user and get token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login auth user",
                "parameters": [
                    {
                        "description": "Sign in body",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_auth_request.SignInRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_auth_response.SignInResponse"
                        }
                    }
                }
            }
        },
        "/auth/sign-up": {
            "post": {
                "description": "create auth user account",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Register new auth user account",
                "parameters": [
                    {
                        "description": "Sign up body",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_auth_request.SignUpRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "ok"
                    }
                }
            }
        },
        "/user/profile": {
            "get": {
                "description": "return current user profile",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Show current user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_user_response.GetCurrentProfileResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "creates user profile if not exits",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Create user profile",
                "parameters": [
                    {
                        "description": "User body",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_user_request.CreateProfileRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/tanneryApp_internal_delivery_http_v1_user_response.CreateProfileResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "tanneryApp_internal_delivery_http_v1_auth_request.SignInRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "maxLength": 20,
                    "minLength": 5
                },
                "password": {
                    "type": "string",
                    "maxLength": 40,
                    "minLength": 8
                }
            }
        },
        "tanneryApp_internal_delivery_http_v1_auth_request.SignUpRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "maxLength": 20,
                    "minLength": 5
                },
                "password": {
                    "type": "string",
                    "maxLength": 40,
                    "minLength": 8
                }
            }
        },
        "tanneryApp_internal_delivery_http_v1_auth_response.SignInResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                }
            }
        },
        "tanneryApp_internal_delivery_http_v1_user_request.CreateProfileRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "nickname": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                }
            }
        },
        "tanneryApp_internal_delivery_http_v1_user_response.CreateProfileResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                }
            }
        },
        "tanneryApp_internal_delivery_http_v1_user_response.GetCurrentProfileResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "nickname": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    }
}